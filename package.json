{
  "name": "recipe-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "transcribe": "node --env-file-if-exists=.env.local scripts/transcribe-pending.mjs",
